# Puerto local de ChartDB.
CHARTDB_PORT=8086

# Opcional. Activa las funciones de IA; no pertenece a la suscripción Plus.
CHARTDB_OPENAI_API_KEY=

# Mantén true para desactivar la telemetría de ChartDB.
CHARTDB_DISABLE_ANALYTICS=true

# Versión de la imagen (fijada para builds reproducibles).
# CHARTDB_VERSION=1.20.1
