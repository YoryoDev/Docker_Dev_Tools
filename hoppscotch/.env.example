# Puerto local de Hoppscotch y su panel de administración.
HOPPSCOTCH_PORT=8084

# Obligatoria. Usa una contraseña aleatoria sin caracteres que requieran
# codificación dentro de una URL, por ejemplo la salida de: openssl rand -hex 24
HOPPSCOTCH_DB_PASSWORD=

# La misma contraseña codificada para URL (por ejemplo, @ es %40 y $ es %24).
HOPPSCOTCH_DB_PASSWORD_URL=

# Obligatoria. Debe tener exactamente 32 caracteres.
# Puedes generarla con: openssl rand -hex 16
HOPPSCOTCH_ENCRYPTION_KEY=
