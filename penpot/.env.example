# Puerto local de la interfaz web.
PENPOT_PORT=8087

# Debe coincidir con la versión del paquete MCP.
PENPOT_VERSION=2.15.4

# Obligatoria. Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=

# Obligatoria. Usa una cadena hexadecimal segura: openssl rand -hex 24
PENPOT_DB_PASSWORD=

# Puertos locales del plugin, MCP HTTP y WebSocket.
PENPOT_MCP_PLUGIN_PORT=4400
PENPOT_MCP_PORT=4401
PENPOT_MCP_WEBSOCKET_PORT=4402

# Carpeta a la que el MCP puede importar y exportar archivos.
PENPOT_MCP_FILES=./files
