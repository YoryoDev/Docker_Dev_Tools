{
  "$schema": "https://opencode.ai/config.json",

  // MCP disponibles únicamente dentro de este proyecto.
  // Copia solo los servidores que necesites en otros proyectos.
  "mcp": {
    "servers": {
      // Requiere iniciar excalidraw/compose.yaml.
      "excalidraw": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "--interactive",
          "--rm",
          "--network",
          "dev-tools-excalidraw_default",
          "--mount",
          "source=dev-tools-excalidraw_excalidraw-data,target=/app/data",
          "--env",
          "EXPRESS_SERVER_URL=http://canvas:3000",
          "--env",
          "ENABLE_CANVAS_SYNC=true",
          "sanjibdevnath/mcp-excalidraw-local:latest"
        ],
        "timeout": {
          "startup": 120000,
          "catalog": 120000
        }
      },
      // Requiere iniciar Hoppscotch e iniciar sesión en el navegador.
      "hoppscotch": {
        "type": "local",
        "command": [
          "/home/yoryo/.local/bin/mise",
          "exec",
          "--",
          "npx",
          "-y",
          "@hoppscotch/mcp-server@1.0.1"
        ],
        "environment": {
          // Dirección de la instancia local.
          "HOPPSCOTCH_SERVER_URL": "http://127.0.0.1:8084",
          // Herramientas habituales sin administración avanzada.
          "HOPPSCOTCH_TOOL_PROFILE": "core",
          // Evita cambios sensibles desde un .env ajeno.
          "HOPPSCOTCH_STRICT_ENV": "true"
        }
      },

      // MCP oficial de Penpot ejecutado por penpot/compose.yaml.
      "penpot": {
        "type": "remote",
        "url": "http://127.0.0.1:4401/mcp",
        "oauth": false,
        "timeout": {
          "startup": 60000,
          "catalog": 60000,
          "execution": 300000
        }
      }
    }
  }
}
